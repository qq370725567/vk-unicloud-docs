#app .home #main-title{
	font-weight: 700;
	font-size: 2rem;
}
#app .home .hero .description{
	color: #606266;
	font-size: 1.1rem;
	border: none;
	line-height: 1.7;
}
#app .home .feature p {
	font-size: 14px;
	color: #909399;
	margin-bottom: 40px;
}

#app .home .footer {
	padding: 30px 0;
	color: #606266;
	text-align: center;
	font-size: 14px;
}
#app .sidebar-group.is-sub-group > .sidebar-heading:not(.clickable) {
	opacity: 1;
}
#app .sidebar-group.is-sub-group > .sidebar-heading {
	font-size: 1em;
	line-height: 1.4;
	font-weight: normal;
	padding-left: 2rem;
}

#app .sidebar-links .sidebar-heading{
	font-size: 1.02em;
}
#app .sidebar > .sidebar-links > li > a.sidebar-link {
	font-size: 1.02em;
}

#app blockquote{
  font-size: 0.94rem;
  color: #858585;
  border-left: 0.2rem solid #409eff;
  margin: 1rem 0;
  padding: 0 0 0 20px;
}
#app blockquote p{
  font-weight: 600;
  margin-left: 0;
}


.sidebar::-webkit-scrollbar, body::-webkit-scrollbar {
	width: 6px;
}
.sidebar:hover::-webkit-scrollbar-thumb, body::-webkit-scrollbar-thumb {
  background: rgba(135,135,135,0.4);
}
.sidebar::-webkit-scrollbar-thumb {
	background: transparent;
	border-radius: 6px;
}
.sidebar:hover::-webkit-scrollbar-track, body::-webkit-scrollbar-track {
  background:  rgba(135,135,135,0.1);
}
body::-webkit-scrollbar-thumb {
	background: rgba(135,135,135,0.5);
	border-radius: 6px;
}

#app .page-edit .edit-link a{
  color: #409eff;
}

#app .go-to-top{
  z-index:9;
}

/* 滚动条美化方案开始 去掉下方css的注释即可 */
#app .ra-wrapper ::-webkit-scrollbar {
	width: 6px;
	height: 6px;
}
#app .ra-wrapper ::-webkit-scrollbar-track {
	background: rgba(135, 135, 135, 0.1);
}
#app .ra-wrapper ::-webkit-scrollbar-thumb {
	background: rgba(135, 135, 135, 0.4);
	border-radius: 6px;
}
#app .ra-wrapper ::-webkit-scrollbar-thumb:hover {
	background: rgba(135, 135, 135, 0.8);
}
/* 滚动条美化方案结束 */
#app {
  --ra-wrapper-width: 230px;
}
#app .ra-wrapper{
  width: var(--ra-wrapper-width);
  max-height: calc(100vh - 10px);
  box-sizing: border-box;
  border-bottom: 1px solid #eaecef;
}
#app .ra-wrapper.is-global {
  top: 0;
  right: 0;
}

#app .page{
  padding-right: var(--ra-wrapper-width);
}


// #app .ra-wrapper.is-global {
//   top: 0;
//   right: inherit;
//   left: 20rem;
// }
// #app .page{
//   padding-left: var(--ra-wrapper-width);
// }


#app .ra-wrapper .ra-menu-item{
  max-width: calc(var(--ra-wrapper-width) - 40px);
  font-size: 12px;
  word-break: break-all;
  overflow: hidden;
   /* white-space: nowrap;
  text-overflow: ellipsis; */
}
#app .ra-wrapper .ra-menu-item.h1 {
  padding-left: 16px;
  font-size: 12px;
  text-align: left;
  word-break: break-all;
  overflow: hidden;
}
#app .go-to-top {
  right: calc(var(--ra-wrapper-width) + 0.2rem)
}

#app .last-updated {
  display: none !important;
}

/* 设置虚拟滚动条 */
#app .search-box .suggestions{
  max-height: 80vh;
  width: 666px;
  overflow-y: auto;
}

/* 子标题加粗 */

#app .sidebar-group.is-sub-group .sidebar-heading span,
#app .sidebar-sub-header:has(> .sidebar-sub-headers) > .sidebar-link {
  font-weight: bold;
}

// #app .sidebar-links > li > .sidebar-sub-headers > .sidebar-sub-header > .sidebar-link {
//   font-weight: bold;
// }

@media (max-width: 1200px) {
  #app .ra-wrapper{
    display: none;
  }
  #app .theme-default-content:not(.custom){
    padding: 2rem 2.5rem;
  }
  #app .go-to-top {
    right: 2.5rem;
  }
  #app .page{
    padding-right: 0;
  }
  #app .home .features {
    padding: 0.5rem 0;
  }
}

@media (min-width: 1900px) {
  #app {
    --ra-wrapper-width: 360px;
  }
  #app .ra-wrapper .ra-menu-item{
    font-size: 14px;
  }
  #app .ra-wrapper .ra-menu-item.h1 {
    font-size: 14px;
    padding-left: 14px;
  }
}

@media (min-width: 2900px) {
  #app {
    --ra-wrapper-width: 460px;
  }
  #app .ra-wrapper .ra-menu-item{
    font-size: 14px;
  }
  #app .ra-wrapper .ra-menu-item.h1 {
    font-size: 14px;
    padding-left: 14px;
  }
}

/* 左侧菜单横幅广告样式 - 开始 */
.sidebar-banner {
  margin: 1rem 0;
  padding: 0 1rem;
  position: relative;
  z-index: 10;
}

.sidebar-banner .banner-link {
  display: block;
  text-decoration: none;
  transition: all 0.3s ease;
}

.sidebar-banner .banner-link:hover {
  transform: translateY(-2px);
}

.sidebar-banner .banner-image {
  width: 85%;
  height: auto;
  border-radius: 8px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  display: block;
  margin: 0 auto;
}

.sidebar-banner .banner-link:hover .banner-image {
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}

#app .sidebar > .sidebar-links {
  padding: 0;
}

@media (max-width: 719px) {
  #app .search-box .suggestions {
    width: calc(100vw - 2rem);
    max-height: 80vh;
  }
}
/* 左侧菜单横幅广告样式 - 结束 */
